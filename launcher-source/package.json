{
  "name": "aether-client-launcher",
  "productName": "AETHER CLIENT",
  "version": "1.4.0",
  "description": "AETHER Minecraft Java launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-packager . AETHER-CLIENT --platform=win32 --arch=x64 --out=dist --overwrite --prune=true"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2"
  }
}