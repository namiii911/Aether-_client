{
  "name": "aether-client-launcher",
  "productName": "AETHER CLIENT",
  "version": "1.5.0",
  "description": "AETHER Minecraft Java launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-packager": "^17.1.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "minecraft-launcher-core": "3.18.2",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.aetherclient.launcher",
    "productName": "AETHER CLIENT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AETHER-CLIENT-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AETHER CLIENT"
    }
  }
}
